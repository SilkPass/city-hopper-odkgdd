
{
  "expo": {
    "name": "Seric",
    "slug": "seric",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/540cb872-3bd0-4f2d-b856-4a78124475c0.jpeg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/540cb872-3bd0-4f2d-b856-4a78124475c0.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#C94B6F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seric.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/540cb872-3bd0-4f2d-b856-4a78124475c0.jpeg",
        "backgroundColor": "#C94B6F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.seric.app"
    },
    "web": {
      "favicon": "./assets/images/540cb872-3bd0-4f2d-b856-4a78124475c0.jpeg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "seric",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
